# Salin file ini menjadi ".env" lalu isi dengan URL Web App Google Apps Script kamu.
# Lihat panduan lengkap di README.md bagian "Menghubungkan ke Google Spreadsheet".

VITE_API_URL=https://script.google.com/macros/s/GANTI_DENGAN_ID_DEPLOYMENT/exec

# Client ID OAuth Google untuk login admin (lihat README bagian "Setup Admin (Google Login)").
VITE_GOOGLE_CLIENT_ID=GANTI_DENGAN_CLIENT_ID_GOOGLE_CLOUD.apps.googleusercontent.com
